# Copy this file to .env and fill in real values.
# Never commit the real .env to version control.

# --- Web Server Port (Windows Service / Standalone) ---
# Default port for the PHP background web service. You can change this to 80, 8000, 8888, 9000, etc.
APP_PORT=8080

# --- MySQL ---
# DB_HOST is "127.0.0.1" when running natively on Windows with XAMPP or local MySQL.
# Use "db" only if running inside Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=notifier
DB_USER=root
DB_PASS=

# --- Bot tokens (from @Bot_Father on each platform) ---
TELEGRAM_BOT_TOKEN=changeme
BALE_BOT_TOKEN=changeme

# --- Optional Telegram Proxy (Only if server is in Iran and Telegram is blocked) ---
# Examples: socks5h://127.0.0.1:10808 or http://127.0.0.1:10809
# TELEGRAM_PROXY=

# --- Bot branding ---
# Logo image sent with the /start welcome message (photo + caption).
# Relative paths resolve from the project root; default: assets/bot-logo.png
BOT_LOGO_PATH=assets/bot-logo.png

# --- Webhooks ---
# Shared secret both webhooks require on every call.
# Generate a strong value:  php -r "echo bin2hex(random_bytes(32));"
WEBHOOK_SECRET=changeme

# --- ngrok (Optional - only needed for tunnels) ---
NGROK_AUTHTOKEN=changeme
